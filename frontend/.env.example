# Where this process reaches Laravel. Server-side only — never sent to a browser.
LARAVEL_ORIGIN=http://127.0.0.1:8000

# The site's own address, used to resolve canonical and og:url tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=50 Plus Voyagers
NEXT_PUBLIC_API_BASE_URL=/api
