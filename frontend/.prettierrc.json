{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 4,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/styles/app.css",
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": ["**/*.yml", "**/*.yaml", "**/*.json"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
